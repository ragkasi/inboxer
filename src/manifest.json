{
  "manifest_version": 3,
  "name": "Inbox Group & Mass-Delete",
  "version": "1.0.1",
  "description": "Group your emails by sender/company for quick mass-deletion.",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://graph.microsoft.com/ https://login.microsoftonline.com/ https://www.googleapis.com/ https://gmail.googleapis.com/"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [{
    "matches": [
      "https://mail.google.com/*",
      "https://outlook.office.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Email Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["graph-shim.js", "popup.html", "popup.js", "react.js", "redux.js", "724.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "oauth2": {
    "client_id": "${GOOGLE_CLIENT_ID}",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}